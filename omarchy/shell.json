{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "io.github.thetrueferret.decent-workspaces"
        },
        {
          "id": "crmne.mpris"
        },
        {
          "id": "itdir.cava",
          "bars": 64,
          "color": "gradient",
          "hideWhenSilent": true
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "design": "editorial"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "io.github.sirjul1337.lock-explorer"
  ],
  "_pluginSources": {
    "crmne.mpris": "https://github.com/crmne/omarchy-mpris.git",
    "io.github.sirjul1337.lock-explorer": "https://github.com/SirJul1337/omarchy-lock-explorer.git",
    "io.github.thetrueferret.decent-workspaces": "https://github.com/TheTrueFerret/omarchy-decent-workspaces.git",
    "itdir.cava": "https://github.com/ltehacker/omarchy-quattro-wave"
  }
}
