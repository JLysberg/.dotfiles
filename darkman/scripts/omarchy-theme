#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  light)
    target_theme="Nord"
    current_theme_name="nord"
    ;;
  dark)
    target_theme="Hackerman"
    current_theme_name="hackerman"
    ;;
  *)
    echo "Usage: $0 <light|dark>" >&2
    exit 64
    ;;
esac

export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export PATH="$OMARCHY_PATH/bin:$HOME/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:$PATH"

theme_name_file="$HOME/.local/state/omarchy/current/theme.name"

current_theme="$(cat "$theme_name_file" 2>/dev/null || true)"

if [[ "$current_theme" == "$current_theme_name" ]]; then
  exit 0
fi

exec "$OMARCHY_PATH/bin/omarchy" theme set "$target_theme"
