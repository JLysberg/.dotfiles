# Omarchy-managed plugin checkouts remain independent Git repositories.
/omarchy/plugins/

# Lock Explorer exposes bundled and user-selected media here.
/omarchy/lock-videos/

# Cliamp recreates its log and local IPC files at runtime.
/cliamp/*.log
/cliamp/*.sock
/cliamp/*.sock.pid

# Herdr keeps logs, IPC sockets, locks, and persisted session state beside its config.
/herdr/*.log
/herdr/*.sock
/herdr/.plugins.lock
/herdr/session.json
/herdr/sessions/
